# Experiment: SocratTeachLLM (9B GLM4-based fine-tune from KELE paper) served
# locally via vLLM 0.21+ on the RTX 5090 (port 8001). The original llama.cpp
# path on port 8080 is blocked on TODO #18 (chatglm.py converter pulls BPE
# merges unconditionally; SocratTeachLLM ships tiktoken only, no merges.txt).
#
# The vLLM path itself was previously blocked by ABI rot (vllm 0.19 + torch
# 2.11) and bitsandbytes/ChatGLM TorchScript trouble — those are documented in
# docs/BENCHMARK_CRITIQUE_AND_PROPOSAL.md §Limitation:definitive-test-blocked.
# 2026-05-23 fix: upgrade to vllm 0.21.0, prepend .venv/bin to PATH for ninja
# discovery under nohup, and bump --gpu-memory-utilization to 0.70 (the 0.60
# default leaves no KV cache room on a 32 GB 5090).
#
# Boot the server with:    bash scripts/serve_socratteachllm.sh
# Eval orchestrator:        bash scripts/eval_bert_socratteachllm_fewshot10_full.sh
#
# Sizing on the 5090 at fp16 / 8K context / 0.70 mem util:
#   Engine ~24 GB total (weights ~18 GB + KV pool ~5 GB); ~7 GB headroom for
#   the consultant load (BERT ~440 MB at 4 workers, qwen3.5 LoRA ~1.5 GB).

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8001/v1
CONSULTANT_MODEL_NAME=SocratTeachLLM
# 4096 — SocratTeachLLM's Modelfile defaults to 4K and that's what the original
# KELE paper used. Larger context risks behavioral drift from the trained
# response distribution.
CONSULTANT_MAX_TOKENS=4096
# CONSULTANT_NUM_CTX intentionally unset — Ollama-only knob; llama.cpp ignores it.
# llama-server's -c flag (set in serve_socratteachllm_llamacpp.sh) is authoritative.

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8001/v1
TEACHER_MODEL_NAME=SocratTeachLLM

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
