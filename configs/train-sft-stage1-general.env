# SFT fine-tuning — Stage 1: scoped general-instruction SFT on Qwen3.6-27B
#
# Target hardware: AMD R9700 AI PRO (32 GB), QLoRA 4-bit NF4.
#
# Stage 1 is *gated* by an A/B against Stage-2b-alone: if Stage 1 → 2b doesn't
# lift synthetic unified by ≥1.0, Stage 1 gets dropped (TRAINING_PLAN.md §2,
# §2 Stage 1). The filter is keyword + length, ~30-50k pedagogy-adjacent records
# total across the three sources. Loaders stream from HF (`streaming=True`) so
# memory stays bounded.
#
# Usage:
#   uv run python scripts/train_sft.py --config configs/train-sft-stage1-general.env
#   uv run python scripts/train_sft.py --config configs/train-sft-stage1-general.env --dry-run
#
# ⚠️ HF dataset downloads on first run: OpenHermes-2.5 (~2 GB), UltraChat 200k
# (~1.5 GB), SlimOrca-Dedup (~700 MB). Total ~4 GB to disk. The stream stops
# once each TRAIN_STAGE1_*_N quota is hit, so RAM usage stays small even on the
# 1M-record OpenHermes set.

# ── Base model ────────────────────────────────────────────────────────────────
# Same base as Stage 2; Stage 1 outputs become the starting point for Stage 2.
TRAIN_BASE_MODEL=Qwen/Qwen3.6-27B-Instruct

# ── Training method ───────────────────────────────────────────────────────────
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
# Matched to Stage 2 so the adapter shape is consistent across stages and the
# Stage 1 checkpoint loads cleanly as the Stage 2 starting point.
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
# Stage 1 is "subtle shaping," not full domain adaptation. 1 epoch + lower LR
# avoids catastrophic forgetting of the instruction-tuned base before Stage 2's
# Socratic conditioning lands (TRAINING_PLAN.md §2 Stage 1).
TRAIN_EPOCHS=1
TRAIN_LR=2e-5
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=2048
TRAIN_BF16=true
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
# Pedagogy-adjacent subsets via the keyword+length filter in
# src/project/dataset.py:_passes_pedagogy_filter. Tune per-source target counts
# below; defaults sum to 35k (within the 30-50k design range).
TRAIN_SOURCES=openhermes-2.5,ultrachat_200k,slimorca-dedup

# Per-source target counts (post-filter). Loaders stream until each cap is hit.
TRAIN_STAGE1_OPENHERMES_N=15000
TRAIN_STAGE1_ULTRACHAT_N=10000
TRAIN_STAGE1_SLIMORCA_N=10000

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-stage1-general
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
