# SFT fine-tuning — Stage 2: Socratic teaching SFT on Gemma 4 26B-A4B-IT (MoE)
#
# Target hardware: AMD R9700 AI PRO (32 GB), ROCm 7.2, gfx1201.
# MoE: 25.2B total params, 3.8B active per forward. NF4 base ~12.6 GB.
# Do NOT run patch-fla-rocm before this target.
#
# Usage:
#   # Stage 2b (default — structural, state-conditioned):
#   uv run --no-sync python scripts/train_sft.py --config configs/train-sft-stage2-gemma4-26b-a4b.env
#
# Launch (R9700):
#   mkdir -p outputs/sft-stage2-gemma4-26b-a4b
#   nohup env TORCH_USE_HIPBLASLT=0 PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.8 \
#     uv run --no-sync python scripts/train_sft.py \
#     --config configs/train-sft-stage2-gemma4-26b-a4b.env \
#     > outputs/sft-stage2-gemma4-26b-a4b/train.log 2>&1 &

# ── Base model ────────────────────────────────────────────────────────────────
# Set to local prequant path once rsync'd: models/gemma-4-26b-a4b-nf4
TRAIN_BASE_MODEL=google/gemma-4-26B-A4B-it

# ── Training method ───────────────────────────────────────────────────────────
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
TRAIN_EPOCHS=3
TRAIN_LR=5e-5
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=1280
TRAIN_BF16=true
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
TRAIN_SOURCES=socrat-zh,socrat-en

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-stage2-gemma4-26b-a4b
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
