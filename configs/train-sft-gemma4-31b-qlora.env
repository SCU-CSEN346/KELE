# SFT fine-tuning — QLoRA on Gemma 4 31B-IT (4-bit NF4)
#
# Target hardware: AMD R9700 AI PRO (32 GB), ROCm 7.2, gfx1201.
# No flash-linear-attention dependency — Gemma 4 uses standard softmax attention
# (local sliding-window + periodic global). SDPA backend is stable on gfx1201.
# Do NOT run patch-fla-rocm before this target.
#
# VRAM estimate at seq=1280: ~21-23 GB peak (4-bit base ~16 GB + LoRA + activations).
# ~9-11 GB headroom on 32 GB — fits without VRAM pressure.
#
# Launch (R9700):
#   mkdir -p outputs/sft-gemma4-31b-qlora
#   nohup env TORCH_USE_HIPBLASLT=0 PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.8 \
#     uv run --no-sync python scripts/train_sft.py \
#     --config configs/train-sft-gemma4-31b-qlora.env \
#     > outputs/sft-gemma4-31b-qlora/train.log 2>&1 &
#
# Dry-run (no weights downloaded):
#   uv run python scripts/train_sft.py --config configs/train-sft-gemma4-31b-qlora.env --dry-run
#
# See docs/TRAINING_PLAN.md for the full 3-stage pipeline and curriculum strategy.
# Change TRAIN_SOURCES for different pipeline stages:
#   Stage 2a (breadth):     socrateach-multi,socrateach-single
#   Stage 2b (structural):  socrat-zh,socrat-en
#   Full mix:               socrat-zh,socrat-en,socrateach-multi,socrateach-single

# ── Base model ────────────────────────────────────────────────────────────────
# IT variant: chat template already baked in; SFTTrainer uses apply_chat_template.
# Phase 1 baseline: selected on velocity (n=37 CIs overlap with Qwen3.6-27B).
# Phase 2 sibling of train-sft-qwen36-27b-qlora.env — identical hyperparameters.
TRAIN_BASE_MODEL=google/gemma-4-31b-it

# ── Training method ───────────────────────────────────────────────────────────
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
# r=16: same as Qwen 27B plan — 31B has sufficient capacity per parameter.
# alpha=32 = 2×r (standard). Gemma 4 uses the same projection names as Llama-style
# architectures; all seven targets verified against the model's named modules.
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
# 3 epochs / lr=5e-5 matches the KELE Stage 2b recipe and the Qwen sibling config.
# Effective batch = 1 × 16 = 16 (matches paper).
# seq=1280: covers data p100 (953 tokens) with 35% buffer; no truncation expected.
TRAIN_EPOCHS=3
TRAIN_LR=5e-5
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=1280
TRAIN_BF16=true
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
TRAIN_SOURCES=socrat-zh,socrat-en

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-gemma4-31b-qlora
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
