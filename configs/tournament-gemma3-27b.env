# Tournament config: Gemma 3 27B Q4 (local ~/Documents/models/weights/).
#
# Google Gemma 3 27B — ~18 GB VRAM at Q4.
# Both teacher and consultant hit the same llama.cpp instance (dual-role).
#
# Boot the server with:   bash scripts/serve_gemma3_27b.sh
# Tournament runner:      uv run tournament run --unified

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Gemma 3 27B
CONSULTANT_MAX_TOKENS=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Gemma 3 27B

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
