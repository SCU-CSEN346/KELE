# Experiment: Gemma 4 31B teacher via a hosted OpenAI-compatible endpoint
# (OpenRouter), with the local Qwen3.5-0.8B-LoRA classifier as the consultant.
#
# This is the "online teacher, local classifier" demo topology: the whole demo
# runs on a laptop — the classifier loads locally (CPU is fine for a 0.8B model;
# set KELE_BERT_DEVICE=cpu to force it), and the teacher is served remotely. No
# local GPU or llama.cpp server needed for the teacher.
#
# Run with:   ONLINE=1 ./scripts/serve_demo_top_performer.sh
#
# The OpenRouter API key is a SECRET — do NOT put it here (this file is
# committed). Put it in the gitignored .env as:
#   TEACHER_API_KEY=sk-or-...
# config.load_env_file() uses setdefault(), so the experiment file deliberately
# omits TEACHER_API_KEY and lets .env (or an exported env var) supply it.
#
# Uses OpenRouter's FREE tier (`:free` suffix) — $0 per call, no credits needed.
# Trade-off: the free tier is rate-limited (capped requests/day, calls can queue),
# so for a heavy live booth either top up the key and drop the `:free` suffix, or
# override per-run:  TEACHER_MODEL_NAME=google/gemma-4-31b-it ONLINE=1 ./scripts/...
#
# Note: a hosted endpoint serves bf16/fp8, not the local UD-Q5_K_XL GGUF the
# 72.24 headline was measured on — outputs will differ. Fine for a live demo,
# not valid for re-measuring the metric.

# Consultant fields are required by the config loader but UNUSED here: the
# --bert-consultant classifier replaces the consultant LLM call entirely.
CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=https://openrouter.ai/api/v1
CONSULTANT_MODEL_NAME=google/gemma-4-31b-it:free

TEACHER_BASE_URL=https://openrouter.ai/api/v1
TEACHER_MODEL_NAME=google/gemma-4-31b-it:free

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
KELE_TEACHER_LANG=auto
