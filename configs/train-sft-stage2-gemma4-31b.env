# SFT fine-tuning — Stage 2: Socratic teaching SFT on Gemma 4 31B-IT
#
# Target hardware: AMD R9700 AI PRO (32 GB), ROCm 7.2, gfx1201.
# No flash-linear-attention dependency — Gemma 4 uses standard softmax attention.
# Do NOT run patch-fla-rocm before this target.
#
# Stage 2 has two sub-phases — start with 2b (structural) and only escalate to
# 2a→2b if Stage 2b-alone underperforms. See TRAINING_PLAN.md §4 Stage 2.
#
# Usage:
#   # Stage 2b (default — structural, state-conditioned):
#   uv run python scripts/train_sft.py --config configs/train-sft-stage2-gemma4-31b.env
#
#   # Stage 2a (breadth — no state conditioning):
#   TRAIN_SOURCES=socrateach-multi,socrateach-single \
#     uv run python scripts/train_sft.py --config configs/train-sft-stage2-gemma4-31b.env
#
#   # 2a → 2b sequence: run 2a first, then point TRAIN_BASE_MODEL at the 2a
#   # checkpoint dir and re-run with the default TRAIN_SOURCES.
#
# Launch (R9700):
#   mkdir -p outputs/sft-stage2-gemma4-31b
#   nohup env TORCH_USE_HIPBLASLT=0 PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.8 \
#     uv run --no-sync python scripts/train_sft.py \
#     --config configs/train-sft-stage2-gemma4-31b.env \
#     > outputs/sft-stage2-gemma4-31b/train.log 2>&1 &
#
# Mirrors train-sft-gemma4-31b-qlora.env in hyperparameters; the only Stage 2
# specifics are TRAIN_OUTPUT_DIR and the Socratic sources.

# ── Base model ────────────────────────────────────────────────────────────────
# For Stage 1 → Stage 2 pipeline: override TRAIN_BASE_MODEL on the command line
# to point at the Stage 1 output dir (outputs/sft-stage1-general).
TRAIN_BASE_MODEL=google/gemma-4-31b-it

# ── Training method ───────────────────────────────────────────────────────────
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
TRAIN_EPOCHS=3
TRAIN_LR=5e-5
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=1280
TRAIN_BF16=true
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
# Default: Stage 2b — structural fine-tuning on state-annotated SocratDataset.
# socrat-synthetic is the contamination-control eval set; never include it here.
TRAIN_SOURCES=socrat-zh,socrat-en

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-stage2-gemma4-31b
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
