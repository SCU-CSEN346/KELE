# Experiment: GLM-4-9B-Chat-base (THUDM/glm-4-9b-chat) — the pre-trained base
# that SocratTeachLLM was LoRA-fine-tuned from. Served locally via vLLM on
# port 8001 (mirror of scripts/serve_socratteachllm.sh).
#
# Why vLLM and not llama.cpp: the llama.cpp ChatGLM converter doesn't embed
# BPE merges, so llama-server fails on load. This affects both this base model
# AND the existing SocratTeachLLM-Q8_0.gguf. vLLM works directly from HF
# weights via trust_remote_code — same path that produced the recorded STL
# n=50 results in May.
#
# Purpose: completes the STL ablation story. Comparing STL vs its own base at
# matched n=681 + matched consultant + matched fewshot10 isolates the
# fine-tune-contribution delta, separating it from:
#   - the GLM-4-9B-Chat pretrain-only baseline performance
#   - the known contamination delta (see docs/SOCRATTEACHLLM_CONTAMINATION_PROOF.md)
#
# Boot the server with:    bash scripts/serve_glm49b_chat.sh
# Eval orchestrator:        bash scripts/eval_bert_glm49b_chat_fewshot10_full.sh

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8001/v1
CONSULTANT_MODEL_NAME=GLM-4-9B-Chat-base
# 4096 — matches STL config (same architecture, same trained context window).
CONSULTANT_MAX_TOKENS=4096

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8001/v1
TEACHER_MODEL_NAME=GLM-4-9B-Chat-base

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
