# Experiment: Claude Sonnet 4.6 as CONSULTANT + SocratTeachLLM as TEACHER.
#
# Literal mirror of the original GPT-4o baseline architecture (configs/baseline.env)
# with Sonnet 4.6 swapped in for GPT-4o. Tests Max's hypothesis: did the KELE
# authors overfit SocratTeachLLM to the dataset? If yes, even a frontier consultant
# shouldn't lift scores much, because the teacher is doing memorized phrasing.
#
# Requires SocratTeachLLM running on :8001 (make serve-socratteachllm).
# Orchestrator must export CONSULTANT_API_KEY="$ANTHROPIC_API_KEY" before invoking.

CONSULTANT_BASE_URL=https://api.anthropic.com/v1/
CONSULTANT_MODEL_NAME=claude-sonnet-4-6
CONSULTANT_MAX_TOKENS=4096

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8001/v1
TEACHER_MODEL_NAME=SocratTeachLLM

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
