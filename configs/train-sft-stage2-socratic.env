# SFT fine-tuning — Stage 2: Socratic teaching SFT on Qwen3.6-27B
#
# Target hardware: AMD R9700 AI PRO (32 GB), QLoRA 4-bit NF4.
#
# Stage 2 has two sub-phases — start with 2b (structural) and only escalate to
# 2a→2b if Stage 2b-alone underperforms. The 2a→2b vs mixed-weighted decision
# is deferred to the §4 ablation runs (TRAINING_PLAN.md §4 Stage 2).
#
# Usage:
#   # Stage 2b (default — structural, state-conditioned):
#   uv run python scripts/train_sft.py --config configs/train-sft-stage2-socratic.env
#
#   # Stage 2a (breadth — no state conditioning):
#   TRAIN_SOURCES=socrateach-multi,socrateach-single,socraticmath \
#     uv run python scripts/train_sft.py --config configs/train-sft-stage2-socratic.env
#
#   # 2a → 2b sequence: run 2a first, then point TRAIN_BASE_MODEL at the 2a
#   # checkpoint dir and re-run with the default TRAIN_SOURCES.
#
# Mirrors train-sft-qwen36-27b-qlora.env in hyperparameters; the only Stage 2
# specifics are TRAIN_OUTPUT_DIR and the Socratic sources.

# ── Base model ────────────────────────────────────────────────────────────────
# For Stage 1 → Stage 2 pipeline: override TRAIN_BASE_MODEL on the command line
# to point at the Stage 1 output dir (outputs/sft-stage1-general).
TRAIN_BASE_MODEL=Qwen/Qwen3.6-27B

# ── Training method ───────────────────────────────────────────────────────────
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
# 3 epochs / lr=5e-5 matches the original KELE Stage 2b recipe. For 2a breadth
# override to TRAIN_EPOCHS=1 — see the usage comment block above.
TRAIN_EPOCHS=3
TRAIN_LR=5e-5
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=2048
TRAIN_BF16=true
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
# Default: Stage 2b — structural fine-tuning on state-annotated SocratDataset.
# The user-turn consultant markers are injected by the loaders per
# TRAINING_PLAN.md §0.2 (Option B: long inference-matching labels).
#
# Note: socrat-synthetic is the contamination-control eval set; never include
# it in TRAIN_SOURCES.
TRAIN_SOURCES=socrat-zh,socrat-en

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-stage2-socratic
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
