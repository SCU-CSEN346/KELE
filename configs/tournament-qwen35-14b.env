# Tournament config: Qwen3-14B UD-Q4_K_XL (local ~/Documents/models/weights/).
#
# Qwen3 14B dense model — ~9 GB VRAM at Q4.
# Both teacher and consultant hit the same llama.cpp instance (dual-role).
# Thinking suppressed server-side via --reasoning off.
#
# Boot the server with:   bash scripts/serve_qwen35_14b.sh
# Tournament runner:      uv run tournament run --unified

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 14B Q4
CONSULTANT_MAX_TOKENS=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 14B Q4

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
CONSULTANT_DISABLE_THINKING=true
