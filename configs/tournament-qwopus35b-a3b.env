# Tournament config: Qwopus3.6-35B-A3B-v1 Q4_K_M (local ~/models/).
#
# Qwen3.6-35B-A3B base with LoRA reasoning fine-tune (9% trainable params,
# three-stage curriculum). Experimental community release.
# Both teacher and consultant hit the same llama.cpp instance (dual-role, 32K ctx).
#
# Boot the server with:   bash scripts/serve_qwopus35b_a3b.sh
# Tournament runner:      uv run tournament run --unified

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwopus 35B A3B
CONSULTANT_MAX_TOKENS=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwopus 35B A3B

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
CONSULTANT_DISABLE_THINKING=true
