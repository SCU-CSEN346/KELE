# Tournament config: Qwen3.5-9B UD-Q4_K_XL (the translation-server model)
#
# Served on port 8080 by scripts/serve_tournament_qwen35_9b.sh.
# Both teacher and consultant hit the same llama.cpp instance (dual-role).
#
# Boot the server with:   bash scripts/serve_tournament_qwen35_9b.sh
# Tournament runner:      uv run tournament run

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 9B Q4
CONSULTANT_MAX_TOKENS=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 9B Q4

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
CONSULTANT_DISABLE_THINKING=true
