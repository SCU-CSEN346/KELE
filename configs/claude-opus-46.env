# Experiment: Claude Opus 4.6 as teacher, BERT consultant (no LLM consultant call).
#
# Identical wiring to claude-sonnet-46.env, only the model ID differs.
# Pricing snapshot (verified 2026-05-21):
#   $5 / MTok input, $25 / MTok output. Full n=681 ~$8 cached, $23 uncached.
#   Only 1.67x Sonnet cost (not 5x as in legacy Opus 4.1 era).

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=https://api.anthropic.com/v1/
CONSULTANT_MODEL_NAME=claude-opus-4-6
CONSULTANT_MAX_TOKENS=4096

TEACHER_BASE_URL=https://api.anthropic.com/v1/
TEACHER_MODEL_NAME=claude-opus-4-6

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
