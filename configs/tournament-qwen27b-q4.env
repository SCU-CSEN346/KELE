# Tournament config: Qwen3.6-27B Q4_K_M (local ~/models/ variant, AMD R9700).
#
# Both teacher and consultant hit the same llama.cpp instance (dual-role, 128K ctx).
#
# Boot the server with:   bash scripts/serve_qwen27b_q4_local.sh
# Tournament runner:      uv run tournament run

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 27B Q4
CONSULTANT_MAX_TOKENS=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 27B Q4

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
CONSULTANT_DISABLE_THINKING=true
