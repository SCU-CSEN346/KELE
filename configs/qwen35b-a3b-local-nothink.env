# Experiment: Qwen3.6-35B-A3B (MoE) Q4_K_M — consultant THINKING DISABLED.
#
# Same as qwen35b-a3b-local.env but with CONSULTANT_DISABLE_THINKING=true
# (prepends "/no_think" to consultant prompts; see socratic_teaching_system.py:312).
#
# Hypothesis: thinking is the bottleneck on consultant turns; disabling it
# preserves classification accuracy while cutting consultant call latency by ~3x.
# Teacher continues to think (no plumbing for teacher-side disable yet).

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 35B A3B
CONSULTANT_MAX_TOKENS=8192
CONSULTANT_DISABLE_THINKING=true

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 35B A3B

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
