# Experiment: Qwen3.6-27B Q5_K_XL — consultant THINKING DISABLED.
#
# Same as qwen27b-local.env but with CONSULTANT_DISABLE_THINKING=true
# (prepends "/no_think" to consultant prompts; see socratic_teaching_system.py:312).
#
# Hypothesis: 27B's strong classification quality is robust to disabling
# consultant thinking; if so we get the +13 state-acc lift over baseline at
# ~3x the throughput, making a full n=681 run viable in ~30-40 h.
# Teacher continues to think (no plumbing for teacher-side disable yet).

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 27B Q5
CONSULTANT_MAX_TOKENS=8192
CONSULTANT_DISABLE_THINKING=true

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 27B Q5

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
