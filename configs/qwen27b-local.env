# Experiment: Qwen3.6-27B Q5_K_XL (clean, NOT uncensored) — fully local, dual-role.
#
# Both the teacher and consultant hit ONE llama.cpp server on port 8080.
# The server runs 6 parallel slots with unified KV cache, so the two roles
# fit on a single model load with no extra VRAM and no contention.
#
# This is the staging configuration for the future unified teacher-consultant
# (see docs/QWEN27B_LOCAL_PLAN.md, Phase 3 — IMPROVEMENT_PLAN.md #4).
#
# Boot the server with:   make serve-qwen27b
# Then in another terminal:  ./scripts/run_eval.sh qwen27b-local --limit 5

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 27B Q5
# 8192 (was 4096) — Qwen3.6 has thinking mode on by default; <think>...</think>
# blocks count against max_tokens. Doubling the cap eliminates any risk that a
# deep-reasoning stage-c turn truncates and falls back to "无法评估". No real
# cost: llama.cpp KV is already allocated for the full 256K context, and the
# model only generates what it needs.
CONSULTANT_MAX_TOKENS=8192
# CONSULTANT_NUM_CTX intentionally unset — that knob is Ollama-specific
# (passed as extra_body.options.num_ctx) and llama.cpp ignores it. The
# server's -c 262144 (256K = native training context) is the actual budget.
# History: ran at 425984 (416K) until 2026-05-22, when the YaRN extrapolation
# plus oversized KV cache tripped an NVRM Xid 8 GPU watchdog lockup.

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 27B Q5

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
