# SFT fine-tuning — QLoRA on Qwen3.6-27B-Instruct (4-bit NF4)
#
# Target hardware: AMD R9700 AI PRO (32 GB).
# QLoRA peaks at ~20–23 GB with gradient checkpointing — fits with ~9 GB headroom.
#
# Usage:
#   uv run python scripts/train_sft.py --config configs/train-sft-qwen36-27b-qlora.env
#   uv run python scripts/train_sft.py --config configs/train-sft-qwen36-27b-qlora.env --dry-run
#
# See docs/TRAINING_PLAN.md for the full 3-stage pipeline and curriculum strategy.
# Change TRAIN_SOURCES for different pipeline stages:
#   Stage 2a (breadth):     socrateach-multi,socrateach-single
#   Stage 2b (structural):  socrat-zh,socrat-en
#   Full mix:               socrat-zh,socrat-en,socrateach-multi,socrateach-single

# ── Base model ────────────────────────────────────────────────────────────────
# Phase 1 base — selected on velocity grounds (n=37 baseline has overlapping
# CIs between Qwen3.6-27B and Gemma 4 31B). See docs/TRAINING_PLAN.md §0.1.
# A Phase 2 head-to-head against Gemma 4 31B is planned using a sibling
# configs/train-sft-gemma4-31b-qlora.env with the same hyperparameters below.
TRAIN_BASE_MODEL=Qwen/Qwen3.6-27B-Instruct

# ── Training method ───────────────────────────────────────────────────────────
# qlora — 4-bit NF4 base + bf16 adapter. Required for 27B on 32 GB.
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
# r=16 for 27B QLoRA: lower rank than the 7B plan (r=32) because 27B has more
# capacity per parameter; keeps adapter VRAM and optimizer overhead minimal.
# alpha=32 = 2×r (standard). All seven linear projections targeted.
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
# 3 epochs matches the original KELE paper (Stage 2b structural fine-tuning).
# For Stage 2a (breadth pre-training), override TRAIN_EPOCHS=1.
# Effective batch = TRAIN_BATCH_SIZE × TRAIN_GRAD_ACCUM = 1 × 16 = 16 (matches paper).
# lr=5e-5 is the paper's value; reduce to 2e-5 if loss spikes at epoch boundaries.
TRAIN_EPOCHS=3
TRAIN_LR=5e-5
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=2048
TRAIN_BF16=true
# Gradient checkpointing: required for 27B QLoRA to keep activations below 32 GB.
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
# Default: Stage 2b (structural fine-tuning on state-annotated data).
# See comment at top of file for other stage configurations.
TRAIN_SOURCES=socrat-zh,socrat-en

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-qwen36-27b-qlora
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
