# Tournament config: DeepSeek-R1-Distill-Qwen-14B Q5_K_M — thinking enabled, budget 8192.
#
# Thinking-enabled variant of tournament-deepseek-r1-14b.env.
# DeepSeek-R1 always generates CoT internally; removing DISABLE_THINKING
# lets the native reasoning run. THINKING_BUDGET may not apply to this model's
# chat template but is included for consistency.
# Boot:  bash scripts/serve_deepseek_r1_14b.sh
# Run:   uv run tournament run --thinking-budget 8192 --unified

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=DeepSeek R1 14B
CONSULTANT_MAX_TOKENS=16384
CONSULTANT_THINKING_BUDGET=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=DeepSeek R1 14B

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
