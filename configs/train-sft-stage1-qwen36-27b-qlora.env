# SFT fine-tuning Stage 1 — QLoRA on Qwen3.6-27B-Instruct (4-bit NF4)
#
# Stage 1 teaches general instruction-following before Socratic specialization.
# Datasets: OpenHermes-2.5, UltraChat-200k, SlimOrca-deduped.
# Collection: https://huggingface.co/collections/ulises-c/general-instruction-dataset-sft-stage-1
#
# Target hardware: AMD R9700 AI PRO (32 GB).
#
# Usage:
#   uv run python scripts/train_sft.py --config configs/train-sft-stage1-qwen36-27b-qlora.env
#   uv run python scripts/train_sft.py --config configs/train-sft-stage1-qwen36-27b-qlora.env --dry-run

# ── Base model ────────────────────────────────────────────────────────────────
TRAIN_BASE_MODEL=Qwen/Qwen3.6-27B-Instruct

# ── Training method ───────────────────────────────────────────────────────────
TRAIN_METHOD=qlora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
LORA_RANK=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
# 1 epoch for Stage 1 — large general-instruction corpus, one pass is sufficient.
# Effective batch = 1 × 16 = 16 (matches Stage 2 config).
TRAIN_EPOCHS=1
TRAIN_LR=2e-4
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_MAX_SEQ_LEN=2048
TRAIN_BF16=true
TRAIN_GRAD_CKPT=true

# ── Dataset sources ───────────────────────────────────────────────────────────
TRAIN_SOURCES=openhermes,ultrachat,slimorca

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-stage1-qwen36-27b-qlora
TRAIN_LOGGING_STEPS=50
TRAIN_SAVE_STEPS=500
TRAIN_EVAL_STEPS=500
