# Tournament config: Qwen3.6-27B Q5_K_XL — thinking enabled, budget 8192.
#
# Thinking-enabled variant of qwen27b-local.env (which had thinking on but
# no explicit budget). Adds CONSULTANT_THINKING_BUDGET=8192.
# Boot:  bash scripts/serve_qwen27b_q5.sh
# Run:   uv run tournament run --thinking-budget 8192 --unified

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=Qwen 27B Q5
CONSULTANT_MAX_TOKENS=16384
CONSULTANT_THINKING_BUDGET=8192

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=Qwen 27B Q5

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
