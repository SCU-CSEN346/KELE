*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/

# Editor / tooling
.claude/
.vscode/
.idea/
*.swp
.DS_Store

# Secrets
.env
.env.local

# Logs (vLLM server, eval runs, nohup dumps)
logs/
*.log
