# Experiment: SocratTeachLLM (9B GLM4-based fine-tune from KELE paper) served
# locally via llama.cpp on the RTX 5090. Replaces the legacy vLLM path
# (configs/local-teacher.env + scripts/serve_socratteachllm.sh) which fell
# afoul of vLLM ABI / ChatGLM TorchScript / bitsandbytes bit-rot. See
# docs/BENCHMARK_CRITIQUE_AND_PROPOSAL.md §Limitation:definitive-test-blocked
# for the original infra-rot diagnosis.
#
# Boot the server with:    bash scripts/serve_socratteachllm_llamacpp.sh
# Convert HF → GGUF first:  bash scripts/convert_socratteachllm_to_gguf.sh
# Eval orchestrator:        bash scripts/eval_bert_socratteachllm_fewshot10_full.sh
#
# Shares port 8080 with all other llama.cpp configs (qwen27b-local,
# gemma4-31b-local, etc.) — only one model can run at a time.
#
# Sizing on the 5090 at Q8_0 / 32K context / 12 parallel slots:
#   Model ~10 GB + KV ~6.5 GB + compute ~1 GB ≈ 17.5 GB; ~14 GB headroom.
#   Can push to 16+ parallel slots if KELE_PARALLEL_WORKERS warrants it.

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=http://localhost:8080/v1
CONSULTANT_MODEL_NAME=SocratTeachLLM
# 4096 — SocratTeachLLM's Modelfile defaults to 4K and that's what the original
# KELE paper used. Larger context risks behavioral drift from the trained
# response distribution.
CONSULTANT_MAX_TOKENS=4096
# CONSULTANT_NUM_CTX intentionally unset — Ollama-only knob; llama.cpp ignores it.
# llama-server's -c flag (set in serve_socratteachllm_llamacpp.sh) is authoritative.

TEACHER_API_KEY=not-needed
TEACHER_BASE_URL=http://localhost:8080/v1
TEACHER_MODEL_NAME=SocratTeachLLM

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
