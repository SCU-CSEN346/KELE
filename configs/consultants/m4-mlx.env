# Qwen3.5-9B-MLX-4bit served via mlx_lm.server on Mac Mini M4 (16 GB unified memory).
# Start with: source configs/consultants/m4-mlx.env && ./scripts/serve_consultant_mlx.sh
# Set CONSULTANT_BASE_URL to the LAN hostname of the Mac Mini you're targeting.
CONSULTANT_API_KEY=no-key
CONSULTANT_BASE_URL=http://Ulisess-Mac-mini.local:8080/v1
CONSULTANT_MODEL_NAME=mlx-community/Qwen3.5-9B-MLX-4bit
CONSULTANT_NUM_CTX=16384
CONSULTANT_MAX_TOKENS=8192
CONSULTANT_DISABLE_THINKING=true
CONSULTANT_THINKING_BUDGET=0
