# SFT fine-tuning — LoRA on Qwen2.5-7B-Instruct (bf16)
#
# Target hardware: AMD R9700 AI PRO (32 GB) or NVIDIA RTX 5090 (32 GB).
# LoRA in bf16 peaks at ~24 GB — fits either GPU without quantization.
# For a 14B model or tighter VRAM budget, switch to TRAIN_METHOD=qlora.
#
# Usage (source then run, or pass via --config):
#   source configs/train-sft-qwen25-7b-lora.env
#   uv run python scripts/train_sft.py
#
#   uv run python scripts/train_sft.py --config configs/train-sft-qwen25-7b-lora.env
#   uv run python scripts/train_sft.py --config configs/train-sft-qwen25-7b-lora.env --dry-run
#
# See docs/TRAINING_PLAN.md for the full LoRA vs QLoRA analysis and curriculum strategy.

# ── Base model ────────────────────────────────────────────────────────────────
TRAIN_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Training method ───────────────────────────────────────────────────────────
# lora   — bf16 full weights + fp32 adapter.  ~24 GB peak.  Best quality.
# qlora  — 4-bit NF4 base + bf16 adapter.    ~12 GB peak.  Use for 14B or tight VRAM.
TRAIN_METHOD=lora

# ── LoRA hyperparameters ──────────────────────────────────────────────────────
# r=32 matches the original paper's expressiveness; lower to 16 if VRAM tight.
# alpha=64 is the standard 2×r. All seven linear projections are targeted.
LORA_RANK=32
LORA_ALPHA=64
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Training hyperparameters ─────────────────────────────────────────────────
# 3 epochs matches the original paper. Effective batch = TRAIN_BATCH_SIZE × TRAIN_GRAD_ACCUM = 16.
# lr=5e-5 is the paper's value; reduce to 2e-5 if loss spikes at epoch boundaries.
TRAIN_EPOCHS=3
TRAIN_LR=5e-5
TRAIN_BATCH_SIZE=4
TRAIN_GRAD_ACCUM=4
TRAIN_MAX_SEQ_LEN=2048
TRAIN_BF16=true
# Gradient checkpointing: not needed for 7B LoRA (fits in 32 GB); enable if tight.
TRAIN_GRAD_CKPT=false

# ── Dataset sources ───────────────────────────────────────────────────────────
# Stage 1 (general instruction):     openhermes,ultrachat,slimorca
# Stage 2a (Socratic breadth):       socrateach-multi,socrateach-single,socratic-math,socratic-math-sol
# Stage 2b (structural, default):    socrat-zh,socrat-en,socrat-synthetic,socrat-synthetic-en
# Stage 2 full mix:                  socrat-zh,socrat-en,socrat-synthetic,socrat-synthetic-en,socrateach-multi,socrateach-single,socratic-math,socratic-math-sol
TRAIN_SOURCES=socrat-zh,socrat-en,socrat-synthetic,socrat-synthetic-en

# ── Output & logging ─────────────────────────────────────────────────────────
TRAIN_OUTPUT_DIR=outputs/sft-qwen25-7b-lora
TRAIN_LOGGING_STEPS=10
TRAIN_SAVE_STEPS=200
TRAIN_EVAL_STEPS=200
