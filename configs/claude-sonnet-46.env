# Experiment: Claude Sonnet 4.6 as teacher, BERT consultant (no LLM consultant call).
#
# Teacher hits Anthropic's OpenAI-compatible endpoint at api.anthropic.com.
# The orchestrator (scripts/eval_bert_claude_fewshot10.sh) exports
# TEACHER_API_KEY from $ANTHROPIC_API_KEY before invoking python.
#
# Consultant fields are required by load_config() but the actual consultant
# call is replaced by the BERT classifier when --bert-consultant is passed.
# Setting CONSULTANT_BASE_URL to the same Anthropic endpoint is a no-op stub
# (BERT never dials out); the dummy model name is just a label.
#
# Pricing snapshot (verified 2026-05-21):
#   $3 / MTok input, $15 / MTok output. Full n=681 ~$5 cached, $14 uncached.

CONSULTANT_API_KEY=not-needed
CONSULTANT_BASE_URL=https://api.anthropic.com/v1/
CONSULTANT_MODEL_NAME=claude-sonnet-4-6
CONSULTANT_MAX_TOKENS=4096

TEACHER_BASE_URL=https://api.anthropic.com/v1/
TEACHER_MODEL_NAME=claude-sonnet-4-6

DEBUG_MODE=false
MAX_TEACHING_ROUNDS=8
